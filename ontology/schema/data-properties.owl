<?xml version="1.0"?>

<rdf:RDF xmlns="http://www.videogame-ontology.org/ontology#"
     xml:base="http://www.videogame-ontology.org/ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:wd="http://www.wikidata.org/entity/"
     xmlns:dcterms="http://purl.org/dc/terms/">

    <owl:Ontology rdf:about="http://www.videogame-ontology.org/ontology/data-properties">
        <rdfs:label>Video Game Ontology: data properties</rdfs:label>
        <rdfs:comment>Datatype properties with domains and ranges.</rdfs:comment>
        <owl:imports rdf:resource="http://www.videogame-ontology.org/ontology/classes"/>
    </owl:Ontology>

<!--
///////////////////////////////////////////////////////////////////////////////////////
Data Properties
///////////////////////////////////////////////////////////////////////////////////////
-->

    <!-- name (general) -->
    <owl:DatatypeProperty rdf:about="#name">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#gameName">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>game name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#gameDescription">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:subPropertyOf rdf:resource="#description"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>game description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#releaseDate">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>release date</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#metacriticScore">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>Metacritic score</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#developerName">
        <rdfs:domain rdf:resource="#Developer"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>developer name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#publisherName">
        <rdfs:domain rdf:resource="#Publisher"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>publisher name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#genreName">
        <rdfs:domain rdf:resource="#Genre"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>genre name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#platformName">
        <rdfs:domain rdf:resource="#Platform"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>platform name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#characterName">
        <rdfs:domain rdf:resource="#Character"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>character name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#franchiseName">
        <rdfs:domain rdf:resource="#Franchise"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>franchise name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#awardName">
        <rdfs:domain rdf:resource="#Award"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>award name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#awardYear">
        <rdfs:domain rdf:resource="#Award"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>award year</rdfs:label>
    </owl:DatatypeProperty>

    <!-- description (general) -->
    <owl:DatatypeProperty rdf:about="#description">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>description</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#officialWebsite">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>official website</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#countryOfOrigin">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>country of origin</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#engineName">
        <rdfs:domain rdf:resource="#GameEngine"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>engine name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasSteamAppId">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Steam App ID</rdfs:label>
        <rdfs:comment>The unique Steam application identifier for this game</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasWikidataId">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Wikidata ID</rdfs:label>
        <rdfs:comment>The Wikidata entity identifier for this resource</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasIGDBId">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>IGDB ID</rdfs:label>
        <rdfs:comment>The Internet Game Database identifier for this game</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reviewScore">
        <rdfs:domain rdf:resource="#Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>review score</rdfs:label>
        <rdfs:comment>The numerical score given by this review</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reviewDate">
        <rdfs:domain rdf:resource="#Review"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>review date</rdfs:label>
        <rdfs:comment>The date on which this review was published</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reviewerName">
        <rdfs:domain rdf:resource="#Review"/>
        <rdfs:subPropertyOf rdf:resource="#name"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>reviewer name</rdfs:label>
        <rdfs:comment>The name of the reviewer or outlet that wrote this review</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#eventDate">
        <rdfs:domain rdf:resource="#GameEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>event date</rdfs:label>
        <rdfs:comment>The date on which this lifecycle event occurred</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#budgetTier">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>budget tier</rdfs:label>
        <rdfs:comment>The budget tier classification of this game (e.g. indie, AA, AAA)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#playerCount">
        <rdfs:domain rdf:resource="#VideoGame"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>player count</rdfs:label>
        <rdfs:comment>The estimated total number of players for this game</rdfs:comment>
    </owl:DatatypeProperty>

</rdf:RDF>
