        <rdfs:label>Japanese Game</rdfs:label>
        <rdfs:comment>A video game whose country of origin is Japan</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#countryOfOrigin"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Japan</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#AmericanGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>American Game</rdfs:label>
        <rdfs:comment>A video game whose country of origin is the United States</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#countryOfOrigin"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">United States</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#MultiPlatformGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Multi-Platform Game</rdfs:label>
        <rdfs:comment>A video game available on at least three platforms. Classified by a SPARQL CONSTRUCT rule (qualified cardinality).</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#availableOn"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="#Platform"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- GameWithSingleDeveloper (necessary, maxCardinality 1) -->
    <owl:Class rdf:about="#GameWithSingleDeveloper">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Game with Single Developer</rdfs:label>
        <rdfs:comment>A video game developed by at most one developer studio. Necessary condition only (subClassOf, not equivalentClass).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#developedBy"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ExclusiveRelease (necessary, maxCardinality 1 on availableOn) -->
    <owl:Class rdf:about="#ExclusiveRelease">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Exclusive Release</rdfs:label>
        <rdfs:comment>A video game available on at most one platform. Necessary condition only (subClassOf, not equivalentClass).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#availableOn"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

</rdf:RDF>
