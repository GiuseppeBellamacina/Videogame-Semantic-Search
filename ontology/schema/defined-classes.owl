<?xml version="1.0"?>

<rdf:RDF xmlns="http://www.videogame-ontology.org/ontology#"
     xml:base="http://www.videogame-ontology.org/ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:wd="http://www.wikidata.org/entity/"
     xmlns:dcterms="http://purl.org/dc/terms/">

    <owl:Ontology rdf:about="http://www.videogame-ontology.org/ontology/defined-classes">
        <rdfs:label>Video Game Ontology: defined classes</rdfs:label>
        <rdfs:comment>Classes defined by equivalence (restrictions, nominals, qualified cardinality, datatype restrictions); classified by the CONSTRUCT rules in rules/.</rdfs:comment>
        <owl:imports rdf:resource="http://www.videogame-ontology.org/ontology/classes"/>
    </owl:Ontology>

<!--
///////////////////////////////////////////////////////////////////////////////////////
Defined classes
///////////////////////////////////////////////////////////////////////////////////////
-->

    <owl:Class rdf:about="#AwardWinningGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Award Winning Game</rdfs:label>
        <rdfs:comment>A video game that has received at least one award.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#wonAward"/>
                        <owl:someValuesFrom rdf:resource="#Award"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#FranchiseGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Franchise Game</rdfs:label>
        <rdfs:comment>A video game that is part of a franchise or series.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#belongsTo"/>
                        <owl:someValuesFrom rdf:resource="#Franchise"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#MultiplayerGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
