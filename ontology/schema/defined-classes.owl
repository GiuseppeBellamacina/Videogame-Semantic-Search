    <owl:Class rdf:about="#SequelGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Sequel Game</rdfs:label>
        <rdfs:comment>A video game that is a sequel to another game.</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#sequelOf"/>
                        <owl:someValuesFrom rdf:resource="#VideoGame"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- StandaloneGame (complementOf) -->
    <owl:Class rdf:about="#StandaloneGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Standalone Game</rdfs:label>
        <rdfs:comment>A video game that is not a sequel to any other game. Classified by a SPARQL CONSTRUCT rule (negation as failure).</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="#sequelOf"/>
                                <owl:someValuesFrom rdf:resource="#VideoGame"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- HighlyRatedGame (datatype restriction: metacriticScore >= 85) -->
    <owl:Class rdf:about="#HighlyRatedGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Highly Rated Game</rdfs:label>
        <rdfs:comment>A video game with a Metacritic score of 85 or above. Classified by a SPARQL CONSTRUCT rule (datatype restriction).</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#metacriticScore"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">85</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- RecentGame (datatype restriction: releaseDate >= 2020-01-01) -->
    <owl:Class rdf:about="#RecentGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Recent Game</rdfs:label>
        <rdfs:comment>A video game released on or after 2020-01-01. Classified by a SPARQL CONSTRUCT rule (datatype restriction).</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#releaseDate"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-01</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#MultiConsoleGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Multi-Console Game</rdfs:label>
        <rdfs:comment>A video game available on at least two console platforms. Classified by a SPARQL CONSTRUCT rule (qualified cardinality).</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#availableOn"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="#ConsolePlatform"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#NintendoPublishedGame">
        <rdfs:subClassOf rdf:resource="#VideoGame"/>
        <rdfs:label>Nintendo Published Game</rdfs:label>
