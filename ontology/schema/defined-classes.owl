        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#VideoGame"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#publishedBy"/>
                        <owl:hasValue rdf:resource="#pub/Nintendo"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

