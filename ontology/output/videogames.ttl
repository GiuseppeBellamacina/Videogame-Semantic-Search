<http://www.videogame-ontology.org/ontology/defined-classes> a owl:Ontology ;
    rdfs:label "Video Game Ontology: defined classes" ;
    rdfs:comment "Classes defined by equivalence (restrictions, nominals, qualified cardinality, datatype restrictions); classified by the CONSTRUCT rules in rules/." ;
    owl:imports <http://www.videogame-ontology.org/ontology/classes> .

vg:AwardWinningGame a owl:Class ;
    rdfs:label "Award Winning Game" ;
    rdfs:comment "A video game that has received at least one award." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:wonAward ;
                        owl:someValuesFrom vg:Award ] ) ] .

vg:FranchiseGame a owl:Class ;
    rdfs:label "Franchise Game" ;
    rdfs:comment "A video game that is part of a franchise or series." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:belongsTo ;
                        owl:someValuesFrom vg:Franchise ] ) ] .

vg:MultiplayerGame a owl:Class ;
    rdfs:label "Multiplayer Game" ;
    rdfs:comment "A video game that supports a multiplayer game mode." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasGameMode ;
                        owl:someValuesFrom vg:MultiplayerMode ] ) ] .

vg:SinglePlayerGame a owl:Class ;
    rdfs:label "Single-Player Game" ;
    rdfs:comment "A video game that supports a single-player game mode." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasGameMode ;
                        owl:someValuesFrom vg:SinglePlayerMode ] ) ] .

vg:CoopGame a owl:Class ;
    rdfs:label "Co-op Game" ;
    rdfs:comment "A video game that supports a cooperative game mode." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasGameMode ;
                        owl:someValuesFrom vg:CoopMode ] ) ] .

vg:PCGame a owl:Class ;
    rdfs:label "PC Game" ;
    rdfs:comment "A video game available on a PC platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:PCPlatform ] ) ] .

vg:ConsoleGame a owl:Class ;
    rdfs:label "Console Game" ;
    rdfs:comment "A video game available on a console platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:ConsolePlatform ] ) ] .

vg:MobileGame a owl:Class ;
    rdfs:label "Mobile Game" ;
    rdfs:comment "A video game available on a mobile platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:MobilePlatform ] ) ] .

vg:NintendoGame a owl:Class ;
    rdfs:label "Nintendo Game" ;
    rdfs:comment "A video game available on a Nintendo platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:NintendoPlatform ] ) ] .

vg:PlayStationGame a owl:Class ;
    rdfs:label "PlayStation Game" ;
    rdfs:comment "A video game available on a PlayStation platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:PlayStationPlatform ] ) ] .

vg:XboxGame a owl:Class ;
    rdfs:label "Xbox Game" ;
    rdfs:comment "A video game available on an Xbox platform." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:XboxPlatform ] ) ] .

vg:SequelGame a owl:Class ;
    rdfs:label "Sequel Game" ;
    rdfs:comment "A video game that is a sequel to another game." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:sequelOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:StandaloneGame a owl:Class ;
    rdfs:label "Standalone Game" ;
    rdfs:comment "A video game that is not a sequel to any other game. Classified by a SPARQL CONSTRUCT rule (negation as failure)." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty vg:sequelOf ;
                                owl:someValuesFrom vg:VideoGame ] ] ) ] .

vg:HighlyRatedGame a owl:Class ;
    rdfs:label "Highly Rated Game" ;
    rdfs:comment "A video game with a Metacritic score of 85 or above. Classified by a SPARQL CONSTRUCT rule (datatype restriction)." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:metacriticScore ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 85 ] ) ] ] ) ] .

vg:RecentGame a owl:Class ;
    rdfs:label "Recent Game" ;
    rdfs:comment "A video game released on or after 2020-01-01. Classified by a SPARQL CONSTRUCT rule (datatype restriction)." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:releaseDate ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:date ;
                                owl:withRestrictions ( [ xsd:minInclusive "2020-01-01"^^xsd:date ] ) ] ] ) ] .

vg:MultiConsoleGame a owl:Class ;
    rdfs:label "Multi-Console Game" ;
    rdfs:comment "A video game available on at least two console platforms. Classified by a SPARQL CONSTRUCT rule (qualified cardinality)." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:ConsolePlatform ;
                        owl:onProperty vg:availableOn ] ) ] .

vg:NintendoPublishedGame a owl:Class ;
    rdfs:label "Nintendo Published Game" ;
    rdfs:comment "A video game published by Nintendo (nominal: hasValue on the Nintendo publisher individual)." ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:hasValue <http://www.videogame-ontology.org/ontology#pub/Nintendo> ;
                        owl:onProperty vg:publishedBy ] ) ] .

vg:WindowsGame a owl:Class ;
    rdfs:label "Windows Game" ;
    rdfs:comment "A video game available on Windows" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:availableOn ;
                        owl:someValuesFrom vg:WindowsPlatform ] ) ] .

