# Entry point for Protégé: File > Open this file. It only imports the three parts of the
# ontology, which stay separate files (resolved to the local files by catalog-v001.xml):
#   schema_generated.ttl  the schema (TBox), generated by generate_schema.py
#   abox_demo.ttl         the demo data (ABox), curated by hand
#   swrl_rules.ttl        the SWRL rules, generated by generate_schema.py
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://www.videogame-ontology.org/ontology/videogames> a owl:Ontology ;
    rdfs:label "Video Game Ontology: schema, demo data and SWRL rules" ;
    owl:imports <http://www.videogame-ontology.org/ontology> ,
        <http://www.videogame-ontology.org/ontology/abox-demo> ,
        <http://www.videogame-ontology.org/ontology/swrl-rules> .
