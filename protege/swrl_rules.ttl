@prefix vg: <http://www.videogame-ontology.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix var: <http://www.videogame-ontology.org/ontology/swrl#> .
<http://www.videogame-ontology.org/ontology/swrl-rules> a owl:Ontology ;
    rdfs:comment "SWRL rules (generated by protege/generate_schema.py), all DL-safe and run by HermiT." ;
    owl:imports <http://www.videogame-ontology.org/ontology> .
var:a a swrl:Variable .
var:b a swrl:Variable .
var:c a swrl:Variable .
var:g a swrl:Variable .
var:h a swrl:Variable .
var:m a swrl:Variable .
var:p a swrl:Variable .
var:q a swrl:Variable .
var:s a swrl:Variable .
var:x a swrl:Variable .
var:y a swrl:Variable .

var:SelfPublished a swrl:Imp ;
    rdfs:label "SelfPublished" ;
    rdfs:comment "developedBy(?g, ?c) ^ publishedBy(?g, ?c) -> SelfPublishedGame(?g)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:developedBy ; swrl:argument1 var:g ; swrl:argument2 var:c ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:publishedBy ; swrl:argument1 var:g ; swrl:argument2 var:c ] ;
      rdf:rest rdf:nil ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:SelfPublishedGame ; swrl:argument1 var:g ] ;
      rdf:rest rdf:nil ] .

var:SequelByDifferentStudio a swrl:Imp ;
    rdfs:label "SequelByDifferentStudio" ;
    rdfs:comment "sequelOf(?a, ?b) ^ developedBy(?a, ?x) ^ developedBy(?b, ?y) ^ differentFrom(?x, ?y) -> SequelByDifferentStudio(?a)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:sequelOf ; swrl:argument1 var:a ; swrl:argument2 var:b ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:developedBy ; swrl:argument1 var:a ; swrl:argument2 var:x ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:developedBy ; swrl:argument1 var:b ; swrl:argument2 var:y ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:DifferentIndividualsAtom ; swrl:argument1 var:x ; swrl:argument2 var:y ] ;
      rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:SequelByDifferentStudio ; swrl:argument1 var:a ] ;
      rdf:rest rdf:nil ] .

var:FirstPartyOnRivalConsole a swrl:Imp ;
    rdfs:label "FirstPartyOnRivalConsole" ;
    rdfs:comment "publishedBy(?g, ?h) ^ availableOn(?g, ?p) ^ ConsolePlatform(?p) ^ manufacturedBy(?p, ?m) ^ differentFrom(?h, ?m) ^ manufacturerOf(?h, ?q) ^ ConsolePlatform(?q) -> FirstPartyOnRivalConsole(?g)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:publishedBy ; swrl:argument1 var:g ; swrl:argument2 var:h ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:availableOn ; swrl:argument1 var:g ; swrl:argument2 var:p ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:ConsolePlatform ; swrl:argument1 var:p ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:manufacturedBy ; swrl:argument1 var:p ; swrl:argument2 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:DifferentIndividualsAtom ; swrl:argument1 var:h ; swrl:argument2 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:manufacturerOf ; swrl:argument1 var:h ; swrl:argument2 var:q ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:ConsolePlatform ; swrl:argument1 var:q ] ;
      rdf:rest rdf:nil ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:FirstPartyOnRivalConsole ; swrl:argument1 var:g ] ;
      rdf:rest rdf:nil ] .

var:FirstPartyOnRivalConsoleGroup a swrl:Imp ;
    rdfs:label "FirstPartyOnRivalConsoleGroup" ;
    rdfs:comment "publishedBy(?g, ?x) ^ subsidiaryOf(?x, ?h) ^ availableOn(?g, ?p) ^ ConsolePlatform(?p) ^ manufacturedBy(?p, ?m) ^ differentFrom(?h, ?m) ^ manufacturerOf(?h, ?q) ^ ConsolePlatform(?q) -> FirstPartyOnRivalConsole(?g)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:publishedBy ; swrl:argument1 var:g ; swrl:argument2 var:x ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:subsidiaryOf ; swrl:argument1 var:x ; swrl:argument2 var:h ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:availableOn ; swrl:argument1 var:g ; swrl:argument2 var:p ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:ConsolePlatform ; swrl:argument1 var:p ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:manufacturedBy ; swrl:argument1 var:p ; swrl:argument2 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:DifferentIndividualsAtom ; swrl:argument1 var:h ; swrl:argument2 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:manufacturerOf ; swrl:argument1 var:h ; swrl:argument2 var:q ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:ConsolePlatform ; swrl:argument1 var:q ] ;
      rdf:rest rdf:nil ] ] ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:FirstPartyOnRivalConsole ; swrl:argument1 var:g ] ;
      rdf:rest rdf:nil ] .

var:CouchCoop a swrl:Imp ;
    rdfs:label "CouchCoop" ;
    rdfs:comment "hasGameMode(?g, ?m) ^ CoopMode(?m) ^ availableOn(?g, ?p) ^ ConsolePlatform(?p) -> CouchCoopCandidate(?g)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:hasGameMode ; swrl:argument1 var:g ; swrl:argument2 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:CoopMode ; swrl:argument1 var:m ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate vg:availableOn ; swrl:argument1 var:g ; swrl:argument2 var:p ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:ConsolePlatform ; swrl:argument1 var:p ] ;
      rdf:rest rdf:nil ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:CouchCoopCandidate ; swrl:argument1 var:g ] ;
      rdf:rest rdf:nil ] .

var:MustPlay a swrl:Imp ;
    rdfs:label "MustPlay" ;
    rdfs:comment "metacriticScore(?g, ?s) ^ xsd:integer(xsd:minExclusive, 94, ?s) -> MustPlayGame(?g)" ;
    swrl:body [ a swrl:AtomList ;
      rdf:first [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate vg:metacriticScore ; swrl:argument1 var:g ; swrl:argument2 var:s ] ;
      rdf:rest [ a swrl:AtomList ;
      rdf:first [ a swrl:DataRangeAtom ; swrl:dataRange [ a rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minExclusive 94 ] ) ] ; swrl:argument1 var:s ] ;
      rdf:rest rdf:nil ] ] ;
    swrl:head [ a swrl:AtomList ;
      rdf:first [ a swrl:ClassAtom ; swrl:classPredicate vg:MustPlayGame ; swrl:argument1 var:g ] ;
      rdf:rest rdf:nil ] .
