@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix var: <http://www.videogame-ontology.org/ontology/regole#> .
@prefix vg: <http://www.videogame-ontology.org/ontology#> .

<http://www.videogame-ontology.org/ontology/regole> a owl:Ontology ;
    rdfs:label "Videogiochi: regole SWRL" ;
    owl:imports <http://www.videogame-ontology.org/ontology> .

var:ConsoleMaker a swrl:Imp ;
    rdfs:label "ConsoleMaker" ;
    rdfs:comment "Un gioco uscito su una console è legato al costruttore di quella console." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:p ;
                    swrl:propertyPredicate vg:availableOn ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 var:p ;
                            swrl:classPredicate vg:ConsolePlatform ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:p ;
                                    swrl:argument2 var:m ;
                                    swrl:propertyPredicate vg:manufacturedBy ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:m ;
                    swrl:propertyPredicate vg:onConsoleOf ] ;
            rdf:rest () ] .

var:DefeatedVillain a swrl:Imp ;
    rdfs:label "DefeatedVillain" ;
    rdfs:comment "Un antagonista ucciso dal protagonista dello stesso gioco è un cattivo sconfitto." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:v ;
                    swrl:argument2 var:g ;
                    swrl:propertyPredicate vg:antagonistOf ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:h ;
                            swrl:argument2 var:g ;
                            swrl:propertyPredicate vg:protagonistOf ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:v ;
                                    swrl:argument2 var:h ;
                                    swrl:propertyPredicate vg:killedBy ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:v ;
                    swrl:classPredicate vg:DefeatedVillain ] ;
            rdf:rest () ] .

var:EngineChangeSequel a swrl:Imp ;
    rdfs:label "EngineChangeSequel" ;
    rdfs:comment "Un seguito che usa un motore diverso da quello del capitolo precedente." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:sequelOf ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:a ;
                            swrl:argument2 var:x ;
                            swrl:propertyPredicate vg:madeWith ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:b ;
                                    swrl:argument2 var:y ;
                                    swrl:propertyPredicate vg:madeWith ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                            swrl:argument1 var:x ;
                                            swrl:argument2 var:y ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:a ;
                    swrl:classPredicate vg:EngineChangeSequel ] ;
            rdf:rest () ] .

var:ExternalEngine a swrl:Imp ;
    rdfs:label "ExternalEngine" ;
    rdfs:comment "Un gioco fatto con un motore sviluppato da un'azienda diversa da quella che ha sviluppato il gioco." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:e ;
                    swrl:propertyPredicate vg:madeWith ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:e ;
                            swrl:argument2 var:m ;
                            swrl:propertyPredicate vg:engineDevelopedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:g ;
                                    swrl:argument2 var:d ;
                                    swrl:propertyPredicate vg:developedBy ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                            swrl:argument1 var:m ;
                                            swrl:argument2 var:d ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:g ;
                    swrl:classPredicate vg:ExternalEngineGame ] ;
            rdf:rest () ] .

var:FirstPartyOnRivalConsole a swrl:Imp ;
    rdfs:label "FirstPartyOnRivalConsole" ;
    rdfs:comment "Un gioco del gruppo di un costruttore di console, uscito su una console fatta da un altro costruttore." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:h ;
                    swrl:propertyPredicate vg:publishedByGroup ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 var:h ;
                            swrl:classPredicate vg:PlatformHolder ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:g ;
                                    swrl:argument2 var:m ;
                                    swrl:propertyPredicate vg:onConsoleOf ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                            swrl:argument1 var:h ;
                                            swrl:argument2 var:m ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:g ;
                    swrl:classPredicate vg:FirstPartyOnRivalConsole ] ;
            rdf:rest () ] .

var:InHouseEngine a swrl:Imp ;
    rdfs:label "InHouseEngine" ;
    rdfs:comment "Un gioco fatto con il motore sviluppato dalla stessa azienda." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:e ;
                    swrl:propertyPredicate vg:madeWith ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:e ;
                            swrl:argument2 var:d ;
                            swrl:propertyPredicate vg:engineDevelopedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:g ;
                                    swrl:argument2 var:d ;
                                    swrl:propertyPredicate vg:developedBy ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:g ;
                    swrl:classPredicate vg:InHouseEngineGame ] ;
            rdf:rest () ] .

var:KillingEvent a swrl:Imp ;
    rdfs:label "KillingEvent" ;
    rdfs:comment "Da un'uccisione (vittima e assassino) ricava la relazione diretta: la vittima è stata uccisa dall'assassino." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:k ;
                    swrl:argument2 var:v ;
                    swrl:propertyPredicate vg:victim ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:k ;
                            swrl:argument2 var:a ;
                            swrl:propertyPredicate vg:killer ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:v ;
                    swrl:argument2 var:a ;
                    swrl:propertyPredicate vg:killedBy ] ;
            rdf:rest () ] .

var:ParentGroup a swrl:Imp ;
    rdfs:label "ParentGroup" ;
    rdfs:comment "Se l'azienda del gruppo è controllata da un'altra, il gioco appartiene anche al gruppo di questa: si sale un livello alla volta." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:publishedByGroup ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:c ;
                            swrl:argument2 var:p ;
                            swrl:propertyPredicate vg:subsidiaryOf ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:p ;
                    swrl:propertyPredicate vg:publishedByGroup ] ;
            rdf:rest () ] .

var:PublisherGroup a swrl:Imp ;
    rdfs:label "PublisherGroup" ;
    rdfs:comment "Il gioco appartiene al gruppo del suo editore: è il primo passo, l'editore stesso." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:publishedBy ] ;
            rdf:rest () ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:publishedByGroup ] ;
            rdf:rest () ] .

var:ReleaseOrder a swrl:Imp ;
    rdfs:label "ReleaseOrder" ;
    rdfs:comment "Un seguito è uscito dopo il capitolo precedente." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:sequelOf ] ;
            rdf:rest () ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:releasedAfter ] ;
            rdf:rest () ] .

var:ReleaseOrderChain a swrl:Imp ;
    rdfs:label "ReleaseOrderChain" ;
    rdfs:comment "L'ordine di uscita risale la serie: se A è uscito dopo B e B è seguito di C, allora A è uscito dopo C." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:releasedAfter ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:b ;
                            swrl:argument2 var:c ;
                            swrl:propertyPredicate vg:sequelOf ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:releasedAfter ] ;
            rdf:rest () ] .

var:ReturnAfterDeath a swrl:Imp ;
    rdfs:label "ReturnAfterDeath" ;
    rdfs:comment "Un personaggio ucciso in un gioco e presente in un gioco uscito dopo è un personaggio che ritorna; quel gioco è un gioco con un ritorno dopo la morte." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:k ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:victim ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:k ;
                            swrl:argument2 var:g ;
                            swrl:propertyPredicate vg:inGame ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:c ;
                                    swrl:argument2 var:h ;
                                    swrl:propertyPredicate vg:appearsIn ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:h ;
                                            swrl:argument2 var:g ;
                                            swrl:propertyPredicate vg:releasedAfter ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:c ;
                    swrl:classPredicate vg:ReturningCharacter ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:ClassAtom ;
                            swrl:argument1 var:h ;
                            swrl:classPredicate vg:ReturnAfterDeathGame ] ;
                    rdf:rest () ] ] .

var:ReturningDirector a swrl:Imp ;
    rdfs:label "ReturningDirector" ;
    rdfs:comment "Un seguito diretto dalla stessa persona che ha diretto il capitolo precedente." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:sequelOf ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:a ;
                            swrl:argument2 var:p ;
                            swrl:propertyPredicate vg:directedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:b ;
                                    swrl:argument2 var:p ;
                                    swrl:propertyPredicate vg:directedBy ] ;
                            rdf:rest () ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:a ;
                    swrl:classPredicate vg:ReturningDirectorSequel ] ;
            rdf:rest () ] .

var:SelfPublished a swrl:Imp ;
    rdfs:label "SelfPublished" ;
    rdfs:comment "Un gioco sviluppato e pubblicato dalla stessa azienda." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:developedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:g ;
                            swrl:argument2 var:c ;
                            swrl:propertyPredicate vg:publishedBy ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:g ;
                    swrl:classPredicate vg:SelfPublishedGame ] ;
            rdf:rest () ] .

var:SequelByDifferentStudio a swrl:Imp ;
    rdfs:label "SequelByDifferentStudio" ;
    rdfs:comment "Un seguito sviluppato da uno studio diverso da quello del capitolo precedente." ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:a ;
                    swrl:argument2 var:b ;
                    swrl:propertyPredicate vg:sequelOf ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:a ;
                            swrl:argument2 var:x ;
                            swrl:propertyPredicate vg:developedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:b ;
                                    swrl:argument2 var:y ;
                                    swrl:propertyPredicate vg:developedBy ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                            swrl:argument1 var:x ;
                                            swrl:argument2 var:y ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:a ;
                    swrl:classPredicate vg:SequelByDifferentStudio ] ;
            rdf:rest () ] .

vg:ConsolePlatform a owl:Class .

vg:DefeatedVillain a owl:Class .

vg:EngineChangeSequel a owl:Class .

vg:ExternalEngineGame a owl:Class .

vg:FirstPartyOnRivalConsole a owl:Class .

vg:InHouseEngineGame a owl:Class .

vg:PlatformHolder a owl:Class .

vg:ReturnAfterDeathGame a owl:Class .

vg:ReturningCharacter a owl:Class .

vg:ReturningDirectorSequel a owl:Class .

vg:SelfPublishedGame a owl:Class .

vg:SequelByDifferentStudio a owl:Class .

vg:antagonistOf a owl:ObjectProperty .

vg:appearsIn a owl:ObjectProperty .

vg:availableOn a owl:ObjectProperty .

vg:inGame a owl:ObjectProperty .

vg:killer a owl:ObjectProperty .

vg:manufacturedBy a owl:ObjectProperty .

vg:protagonistOf a owl:ObjectProperty .

vg:subsidiaryOf a owl:ObjectProperty .

vg:directedBy a owl:ObjectProperty .

vg:engineDevelopedBy a owl:ObjectProperty .

vg:killedBy a owl:ObjectProperty .

vg:onConsoleOf a owl:ObjectProperty .

vg:publishedBy a owl:ObjectProperty .

vg:victim a owl:ObjectProperty .

vg:madeWith a owl:ObjectProperty .

vg:publishedByGroup a owl:ObjectProperty .

vg:releasedAfter a owl:ObjectProperty .

var:d a swrl:Variable .

var:e a swrl:Variable .

var:k a swrl:Variable .

var:x a swrl:Variable .

var:y a swrl:Variable .

vg:developedBy a owl:ObjectProperty .

vg:sequelOf a owl:ObjectProperty .

var:v a swrl:Variable .

var:m a swrl:Variable .

var:p a swrl:Variable .

var:h a swrl:Variable .

var:b a swrl:Variable .

var:c a swrl:Variable .

var:a a swrl:Variable .

var:g a swrl:Variable .

