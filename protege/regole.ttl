                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:DifferentIndividualsAtom ;
                                            swrl:argument1 var:x ;
                                            swrl:argument2 var:y ] ;
                                    rdf:rest () ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:a ;
                    swrl:classPredicate vg:SequelByDifferentStudio ] ;
            rdf:rest () ] .

var:VeteransReturn a swrl:Imp ;
    rdfs:label "VeteransReturn" ;
    rdfs:comment "developedBy(?g, ?c) ^ foundedBy(?c, ?p) ^ formerEmployeeOf(?p, ?o) ^ developerOf(?o, ?h) ^ belongsTo(?g, ?f) ^ belongsTo(?h, ?f) -> VeteransReturn(?g)" ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 var:g ;
                    swrl:argument2 var:c ;
                    swrl:propertyPredicate vg:developedBy ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 var:c ;
                            swrl:argument2 var:p ;
                            swrl:propertyPredicate vg:foundedBy ] ;
                    rdf:rest [ a swrl:AtomList ;
                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                    swrl:argument1 var:p ;
                                    swrl:argument2 var:o ;
                                    swrl:propertyPredicate vg:formerEmployeeOf ] ;
                            rdf:rest [ a swrl:AtomList ;
                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                            swrl:argument1 var:o ;
                                            swrl:argument2 var:h ;
                                            swrl:propertyPredicate vg:developerOf ] ;
                                    rdf:rest [ a swrl:AtomList ;
                                            rdf:first [ a swrl:IndividualPropertyAtom ;
                                                    swrl:argument1 var:g ;
                                                    swrl:argument2 var:f ;
                                                    swrl:propertyPredicate vg:belongsTo ] ;
                                            rdf:rest [ a swrl:AtomList ;
                                                    rdf:first [ a swrl:IndividualPropertyAtom ;
                                                            swrl:argument1 var:h ;
                                                            swrl:argument2 var:f ;
                                                            swrl:propertyPredicate vg:belongsTo ] ;
                                                    rdf:rest () ] ] ] ] ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 var:g ;
                    swrl:classPredicate vg:VeteransReturn ] ;
            rdf:rest () ] .

