# Test 3 (expected: INCONSISTENT). Tears of the Kingdom is stated to be on at most one
# platform (an anonymous restriction: availableOn max 1), but it is on Nintendo Switch and Nintendo Switch 2, which the demo declares
# different (owl:AllDifferent on the platforms): two platforms, so the maximum
# cardinality is violated. Without that declaration OWL (no unique name assumption)
# would satisfy "at most one platform" by concluding Switch = Switch 2: that is why
# the demo states that its platforms are distinct.
@prefix vg:   <http://www.videogame-ontology.org/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
<http://www.videogame-ontology.org/ontology/test-cardinality> a owl:Ontology ;
    owl:imports <http://www.videogame-ontology.org/ontology/abox-demo> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
vg:The_Legend_of_Zelda_Tears_of_the_Kingdom a [ a owl:Restriction ;
        owl:onProperty vg:availableOn ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .
