                                         ]
 ] .

[ rdfs:comment "Un personaggio ucciso in un gioco e presente in un gioco uscito dopo è un personaggio che ritorna; quel gioco è un gioco con un ritorno dopo la morte." ;
   rdfs:label "ReturnAfterDeath" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :victim ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :k ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :inGame ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :k ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :g
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :appearsIn ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :h
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> :releasedAfter ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :h ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :g
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :ReturningCharacter ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :ReturnAfterDeathGame ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :h
                                                                ] ;
                                                      rdf:rest rdf:nil
                                                    ]
                                         ]
 ] .

