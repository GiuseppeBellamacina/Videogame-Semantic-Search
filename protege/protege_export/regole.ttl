@prefix : <http://www.videogame-ontology.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.videogame-ontology.org/ontology#> .

<http://www.videogame-ontology.org/ontology/regole> rdf:type owl:Ontology ;
                                                     owl:imports <http://www.videogame-ontology.org/ontology> ;
                                                     rdfs:label "Videogiochi: regole SWRL" .

#################################################################
#    Rules
#################################################################

:g rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:p rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:m rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:h rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:v rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:k rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:c rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:a rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:b rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:x rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:y rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:e rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

:d rdf:type <http://www.w3.org/2003/11/swrl#Variable> .

[ rdfs:comment "Un gioco uscito su una console è legato al costruttore di quella console." ;
   rdfs:label "ConsoleMaker" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :availableOn ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :p
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :ConsolePlatform ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :p
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :manufacturedBy ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :p ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :m
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :onConsoleOf ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :m
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ rdfs:comment "Un gioco del gruppo di un costruttore di console, uscito su una console fatta da un altro costruttore." ;
   rdfs:label "FirstPartyOnRivalConsole" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :publishedByGroup ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :h
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#classPredicate> :PlatformHolder ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :h
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :onConsoleOf ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :m
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#DifferentIndividualsAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> :h ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> :m
                                                                                      ] ;
                                                                            rdf:rest rdf:nil
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> :FirstPartyOnRivalConsole ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ rdfs:comment "Il gioco appartiene al gruppo del suo editore: è il primo passo, l'editore stesso." ;
   rdfs:label "PublisherGroup" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :publishedBy ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :publishedByGroup ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ rdfs:comment "Se l'azienda del gruppo è controllata da un'altra, il gioco appartiene anche al gruppo di questa: si sale un livello alla volta." ;
   rdfs:label "ParentGroup" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :publishedByGroup ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :subsidiaryOf ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :c ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :p
                                                                ] ;
                                                      rdf:rest rdf:nil
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :publishedByGroup ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :g ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :p
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ rdfs:comment "L'ordine di uscita risale la serie: se A è uscito dopo B e B è seguito di C, allora A è uscito dopo C." ;
   rdfs:label "ReleaseOrderChain" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :releasedAfter ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :b
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :sequelOf ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> :b ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :c
                                                                ] ;
                                                      rdf:rest rdf:nil
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :releasedAfter ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> :a ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :c
                                                     ] ;
                                           rdf:rest rdf:nil
                                         ]
 ] .

[ rdfs:comment "Un seguito è uscito dopo il capitolo precedente." ;
   rdfs:label "ReleaseOrder" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
