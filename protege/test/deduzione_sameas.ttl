# Atteso: consistente; il reasoner deduce NX = Nintendo Switch (NX è il nome in codice della Switch).
@prefix vg: <http://www.videogame-ontology.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://www.videogame-ontology.org/ontology/test/sameas> a owl:Ontology ;
    owl:imports <http://www.videogame-ontology.org/ontology/dati> , <http://www.videogame-ontology.org/ontology/regole> .

<http://www.videogame-ontology.org/ontology#platform/Nintendo_NX> rdfs:label "NX" .

vg:Splatoon_2 a vg:VideoGame , [ a owl:Restriction ;
        owl:onProperty vg:availableOn ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    rdfs:label "Splatoon 2" ;
    vg:availableOn <http://www.videogame-ontology.org/ontology#platform/Nintendo_Switch> ,
        <http://www.videogame-ontology.org/ontology#platform/Nintendo_NX> .
