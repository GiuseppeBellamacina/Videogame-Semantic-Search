# Atteso: inconsistente (al più una piattaforma, ma Breath of the Wild è uscito su Wii U e Switch, dichiarate diverse).
@prefix vg: <http://www.videogame-ontology.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<http://www.videogame-ontology.org/ontology/test/cardinalita> a owl:Ontology ;
    owl:imports <http://www.videogame-ontology.org/ontology/dati> , <http://www.videogame-ontology.org/ontology/regole> .

vg:The_Legend_of_Zelda_Breath_of_the_Wild a [ a owl:Restriction ;
        owl:onProperty vg:availableOn ;
        owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .
