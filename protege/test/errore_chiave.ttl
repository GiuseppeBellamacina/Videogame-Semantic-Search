@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vg: <http://www.videogame-ontology.org/ontology#> .

vg:GTA_V_copia a vg:VideoGame ;
    rdfs:label "GTA V (record duplicato)" ;
    vg:hasWikidataId "Q17452" ;
    owl:differentFrom vg:Grand_Theft_Auto_V .

<http://www.videogame-ontology.org/ontology/test/chiave> a owl:Ontology ;
    rdfs:comment "Atteso: inconsistente (stesso hasWikidataId, chiave di VideoGame, ma dichiarati diversi)" ;
    owl:imports <http://www.videogame-ontology.org/ontology/dati>,
        <http://www.videogame-ontology.org/ontology/regole> .

