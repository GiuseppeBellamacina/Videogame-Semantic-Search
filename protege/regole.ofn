Prefix(:=<http://www.videogame-ontology.org/ontology#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

Ontology(<http://www.videogame-ontology.org/ontology/regole>
Import(<http://www.videogame-ontology.org/ontology>)
Annotation(rdfs:label "Videogiochi: regole SWRL")

DLSafeRule(Annotation(rdfs:label "PublisherGroup") Annotation(rdfs:comment "Il gioco appartiene al gruppo del suo editore: è il primo passo, l'editore stesso.")
  Body(ObjectPropertyAtom(:publishedBy Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)))
  Head(ObjectPropertyAtom(:publishedByGroup Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>))))
DLSafeRule(Annotation(rdfs:label "ParentGroup") Annotation(rdfs:comment "Se l'azienda del gruppo è controllata da un'altra, il gioco appartiene anche al gruppo di questa: si sale un livello alla volta.")
  Body(ObjectPropertyAtom(:publishedByGroup Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)) ObjectPropertyAtom(:subsidiaryOf Variable(<http://www.videogame-ontology.org/ontology/regole#c>) Variable(<http://www.videogame-ontology.org/ontology/regole#p>)))
  Head(ObjectPropertyAtom(:publishedByGroup Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#p>))))
DLSafeRule(Annotation(rdfs:label "ConsoleMaker") Annotation(rdfs:comment "Un gioco uscito su una console è legato al costruttore di quella console.")
  Body(ObjectPropertyAtom(:availableOn Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#p>)) ClassAtom(:ConsolePlatform Variable(<http://www.videogame-ontology.org/ontology/regole#p>)) ObjectPropertyAtom(:manufacturedBy Variable(<http://www.videogame-ontology.org/ontology/regole#p>) Variable(<http://www.videogame-ontology.org/ontology/regole#m>)))
  Head(ObjectPropertyAtom(:onConsoleOf Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#m>))))
DLSafeRule(Annotation(rdfs:label "FirstPartyOnRivalConsole") Annotation(rdfs:comment "Un gioco del gruppo di un costruttore di console, uscito su una console fatta da un altro costruttore.")
  Body(ObjectPropertyAtom(:publishedByGroup Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#h>)) ClassAtom(:PlatformHolder Variable(<http://www.videogame-ontology.org/ontology/regole#h>)) ObjectPropertyAtom(:onConsoleOf Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#m>)) DifferentIndividualsAtom(Variable(<http://www.videogame-ontology.org/ontology/regole#h>) Variable(<http://www.videogame-ontology.org/ontology/regole#m>)))
  Head(ClassAtom(:FirstPartyOnRivalConsole Variable(<http://www.videogame-ontology.org/ontology/regole#g>))))
DLSafeRule(Annotation(rdfs:label "SequelByDifferentStudio") Annotation(rdfs:comment "Un seguito sviluppato da uno studio diverso da quello del capitolo precedente.")
  Body(ObjectPropertyAtom(:sequelOf Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>)) ObjectPropertyAtom(:developedBy Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#x>)) ObjectPropertyAtom(:developedBy Variable(<http://www.videogame-ontology.org/ontology/regole#b>) Variable(<http://www.videogame-ontology.org/ontology/regole#y>)) DifferentIndividualsAtom(Variable(<http://www.videogame-ontology.org/ontology/regole#x>) Variable(<http://www.videogame-ontology.org/ontology/regole#y>)))
  Head(ClassAtom(:SequelByDifferentStudio Variable(<http://www.videogame-ontology.org/ontology/regole#a>))))
DLSafeRule(Annotation(rdfs:label "EngineChangeSequel") Annotation(rdfs:comment "Un seguito che usa un motore diverso da quello del capitolo precedente.")
  Body(ObjectPropertyAtom(:sequelOf Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>)) ObjectPropertyAtom(:madeWith Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#x>)) ObjectPropertyAtom(:madeWith Variable(<http://www.videogame-ontology.org/ontology/regole#b>) Variable(<http://www.videogame-ontology.org/ontology/regole#y>)) DifferentIndividualsAtom(Variable(<http://www.videogame-ontology.org/ontology/regole#x>) Variable(<http://www.videogame-ontology.org/ontology/regole#y>)))
  Head(ClassAtom(:EngineChangeSequel Variable(<http://www.videogame-ontology.org/ontology/regole#a>))))
DLSafeRule(Annotation(rdfs:label "ExternalEngine") Annotation(rdfs:comment "Un gioco fatto con un motore sviluppato da un'azienda diversa da quella che ha sviluppato il gioco.")
  Body(ObjectPropertyAtom(:madeWith Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#e>)) ObjectPropertyAtom(:engineDevelopedBy Variable(<http://www.videogame-ontology.org/ontology/regole#e>) Variable(<http://www.videogame-ontology.org/ontology/regole#m>)) ObjectPropertyAtom(:developedBy Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#d>)) DifferentIndividualsAtom(Variable(<http://www.videogame-ontology.org/ontology/regole#m>) Variable(<http://www.videogame-ontology.org/ontology/regole#d>)))
  Head(ClassAtom(:ExternalEngineGame Variable(<http://www.videogame-ontology.org/ontology/regole#g>))))
DLSafeRule(Annotation(rdfs:label "InHouseEngine") Annotation(rdfs:comment "Un gioco fatto con il motore sviluppato dalla stessa azienda.")
  Body(ObjectPropertyAtom(:madeWith Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#e>)) ObjectPropertyAtom(:engineDevelopedBy Variable(<http://www.videogame-ontology.org/ontology/regole#e>) Variable(<http://www.videogame-ontology.org/ontology/regole#d>)) ObjectPropertyAtom(:developedBy Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#d>)))
  Head(ClassAtom(:InHouseEngineGame Variable(<http://www.videogame-ontology.org/ontology/regole#g>))))
DLSafeRule(Annotation(rdfs:label "ReturningDirector") Annotation(rdfs:comment "Un seguito diretto dalla stessa persona che ha diretto il capitolo precedente.")
  Body(ObjectPropertyAtom(:sequelOf Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>)) ObjectPropertyAtom(:directedBy Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#p>)) ObjectPropertyAtom(:directedBy Variable(<http://www.videogame-ontology.org/ontology/regole#b>) Variable(<http://www.videogame-ontology.org/ontology/regole#p>)))
  Head(ClassAtom(:ReturningDirectorSequel Variable(<http://www.videogame-ontology.org/ontology/regole#a>))))
DLSafeRule(Annotation(rdfs:label "KillingEvent") Annotation(rdfs:comment "Da un'uccisione (vittima e assassino) ricava la relazione diretta: la vittima è stata uccisa dall'assassino.")
  Body(ObjectPropertyAtom(:victim Variable(<http://www.videogame-ontology.org/ontology/regole#k>) Variable(<http://www.videogame-ontology.org/ontology/regole#v>)) ObjectPropertyAtom(:killer Variable(<http://www.videogame-ontology.org/ontology/regole#k>) Variable(<http://www.videogame-ontology.org/ontology/regole#a>)))
  Head(ObjectPropertyAtom(:killedBy Variable(<http://www.videogame-ontology.org/ontology/regole#v>) Variable(<http://www.videogame-ontology.org/ontology/regole#a>))))
DLSafeRule(Annotation(rdfs:label "DefeatedVillain") Annotation(rdfs:comment "Un antagonista ucciso dal protagonista dello stesso gioco è un cattivo sconfitto.")
  Body(ObjectPropertyAtom(:antagonistOf Variable(<http://www.videogame-ontology.org/ontology/regole#v>) Variable(<http://www.videogame-ontology.org/ontology/regole#g>)) ObjectPropertyAtom(:protagonistOf Variable(<http://www.videogame-ontology.org/ontology/regole#h>) Variable(<http://www.videogame-ontology.org/ontology/regole#g>)) ObjectPropertyAtom(:killedBy Variable(<http://www.videogame-ontology.org/ontology/regole#v>) Variable(<http://www.videogame-ontology.org/ontology/regole#h>)))
  Head(ClassAtom(:DefeatedVillain Variable(<http://www.videogame-ontology.org/ontology/regole#v>))))
DLSafeRule(Annotation(rdfs:label "ReleaseOrder") Annotation(rdfs:comment "Un seguito è uscito dopo il capitolo precedente.")
  Body(ObjectPropertyAtom(:sequelOf Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>)))
  Head(ObjectPropertyAtom(:releasedAfter Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>))))
DLSafeRule(Annotation(rdfs:label "ReleaseOrderChain") Annotation(rdfs:comment "L'ordine di uscita risale la serie: se A è uscito dopo B e B è seguito di C, allora A è uscito dopo C.")
  Body(ObjectPropertyAtom(:releasedAfter Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#b>)) ObjectPropertyAtom(:sequelOf Variable(<http://www.videogame-ontology.org/ontology/regole#b>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)))
  Head(ObjectPropertyAtom(:releasedAfter Variable(<http://www.videogame-ontology.org/ontology/regole#a>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>))))
DLSafeRule(Annotation(rdfs:label "ReturnAfterDeath") Annotation(rdfs:comment "Un personaggio ucciso in un gioco e presente in un gioco uscito dopo è un personaggio che ritorna; quel gioco è un gioco con un ritorno dopo la morte.")
  Body(ObjectPropertyAtom(:victim Variable(<http://www.videogame-ontology.org/ontology/regole#k>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)) ObjectPropertyAtom(:inGame Variable(<http://www.videogame-ontology.org/ontology/regole#k>) Variable(<http://www.videogame-ontology.org/ontology/regole#g>)) ObjectPropertyAtom(:appearsIn Variable(<http://www.videogame-ontology.org/ontology/regole#c>) Variable(<http://www.videogame-ontology.org/ontology/regole#h>)) ObjectPropertyAtom(:releasedAfter Variable(<http://www.videogame-ontology.org/ontology/regole#h>) Variable(<http://www.videogame-ontology.org/ontology/regole#g>)))
  Head(ClassAtom(:ReturningCharacter Variable(<http://www.videogame-ontology.org/ontology/regole#c>)) ClassAtom(:ReturnAfterDeathGame Variable(<http://www.videogame-ontology.org/ontology/regole#h>))))
DLSafeRule(Annotation(rdfs:label "SelfPublished") Annotation(rdfs:comment "Un gioco sviluppato e pubblicato dalla stessa azienda.")
  Body(ObjectPropertyAtom(:developedBy Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)) ObjectPropertyAtom(:publishedBy Variable(<http://www.videogame-ontology.org/ontology/regole#g>) Variable(<http://www.videogame-ontology.org/ontology/regole#c>)))
  Head(ClassAtom(:SelfPublishedGame Variable(<http://www.videogame-ontology.org/ontology/regole#g>))))
)
