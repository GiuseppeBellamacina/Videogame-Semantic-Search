@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vg: <http://www.videogame-ontology.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.videogame-ontology.org/ontology> a owl:Ontology ;
    rdfs:label "Videogiochi: schema" .

vg:AcclaimedSequel a owl:Class ;
    rdfs:label "AcclaimedSequel" ;
    rdfs:comment "Un seguito acclamato" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:SequelGame vg:HighlyRatedGame ) ] .

vg:AuteurGame a owl:Class ;
    rdfs:label "AuteurGame" ;
    rdfs:comment "Un gioco diretto da chi guida uno studio" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:directedBy ;
                        owl:someValuesFrom vg:StudioHead ] ) ] .

vg:AwardWinningFranchise a owl:Class ;
    rdfs:label "AwardWinningFranchise" ;
    rdfs:comment "Una serie con un gioco dell'anno" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Franchise [ a owl:Restriction ;
                        owl:onProperty vg:includes ;
                        owl:someValuesFrom vg:GOTYWinner ] ) ] .

vg:ConsensusGOTY a owl:Class ;
    rdfs:label "ConsensusGOTY" ;
    rdfs:comment "Un gioco dell'anno per almeno due cerimonie diverse" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:GOTYWinner [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:Award ;
                        owl:onProperty vg:wonAward ] ) ] .

vg:DefeatedVillain a owl:Class ;
    rdfs:label "DefeatedVillain" ;
    rdfs:comment "Un antagonista ucciso dal protagonista" ;
    rdfs:subClassOf vg:DeceasedCharacter .

vg:EngineChangeSequel a owl:Class ;
    rdfs:label "EngineChangeSequel" ;
    rdfs:comment "Un seguito che cambia motore" ;
    rdfs:subClassOf vg:VideoGame .

vg:ExternalEngineGame a owl:Class ;
    rdfs:label "ExternalEngineGame" ;
    rdfs:comment "Un gioco fatto con un motore sviluppato da un'altra azienda" ;
    rdfs:subClassOf vg:VideoGame .

vg:FantasyViolenceGame a owl:Class ;
    rdfs:label "FantasyViolenceGame" ;
    rdfs:comment "Un gioco violento classificato al più PEGI 12: violenza su personaggi non realistici" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:ViolentStoryGame [ a owl:Restriction ;
                        owl:onProperty vg:pegiRating ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 12 ] ) ] ] ) ] .

vg:FirstPartyGame a owl:Class ;
    rdfs:label "FirstPartyGame" ;
    rdfs:comment "Un gioco pubblicato dal gruppo di un costruttore di console" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:publishedByGroup ;
                        owl:someValuesFrom vg:PlatformHolder ] ) ] .

vg:FirstPartyOnRivalConsole a owl:Class ;
    rdfs:label "FirstPartyOnRivalConsole" ;
    rdfs:comment "Un gioco first-party uscito su una console di un concorrente" ;
    rdfs:subClassOf vg:VideoGame .

vg:FoundedByVeterans a owl:Class ;
    rdfs:label "FoundedByVeterans" ;
    rdfs:comment "Un'azienda fondata da chi lavorava per uno sviluppatore" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Company [ a owl:Restriction ;
                        owl:onProperty vg:foundedBy ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty vg:formerEmployeeOf ;
                                owl:someValuesFrom vg:Developer ] ] ) ] .

vg:FranchiseWithStudioChange a owl:Class ;
    rdfs:label "FranchiseWithStudioChange" ;
    rdfs:comment "Una serie passata a un altro studio" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Franchise [ a owl:Restriction ;
                        owl:onProperty vg:includes ;
                        owl:someValuesFrom vg:SequelByDifferentStudio ] ) ] .

vg:GameDirector a owl:Class ;
    rdfs:label "GameDirector" ;
    rdfs:comment "Chi ha diretto almeno un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Person [ a owl:Restriction ;
                        owl:onProperty vg:directorOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:HistoricalCharacter a owl:Class ;
    rdfs:label "HistoricalCharacter" ;
    rdfs:comment "Un personaggio che interpreta una persona reale" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:portrays ;
                        owl:someValuesFrom vg:Person ] ) ] .

vg:InHouseEngineGame a owl:Class ;
    rdfs:label "InHouseEngineGame" ;
    rdfs:comment "Un gioco fatto con il motore dello stesso studio" ;
    rdfs:subClassOf vg:VideoGame .

vg:KilledMoreThanOnce a owl:Class ;
    rdfs:label "KilledMoreThanOnce" ;
    rdfs:comment "Un personaggio ucciso in almeno due giochi: torna sempre" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:DeceasedCharacter [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:Killing ;
                        owl:onProperty vg:victimIn ] ) ] .

vg:LiteraryAdaptation a owl:Class ;
    rdfs:label "LiteraryAdaptation" ;
    rdfs:comment "Un gioco tratto da un romanzo" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Adaptation [ a owl:Restriction ;
                        owl:onProperty vg:basedOn ;
                        owl:someValuesFrom vg:Novel ] ) ] .

vg:LongRunningFranchise a owl:Class ;
    rdfs:label "LongRunningFranchise" ;
    rdfs:comment "Una serie con almeno tre capitoli" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Franchise [ a owl:Restriction ;
                        owl:onProperty vg:includes ;
                        owl:someValuesFrom vg:LateEntry ] ) ] .

vg:LongRunningOriginal a owl:Class ;
    rdfs:label "LongRunningOriginal" ;
    rdfs:comment "Il capostipite di una serie di almeno tre capitoli" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasSequel ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty vg:hasSequel ;
                                owl:someValuesFrom vg:VideoGame ] ] ) ] .

vg:MultiPlatformGame a owl:Class ;
    rdfs:label "MultiPlatformGame" ;
    rdfs:comment "Un gioco uscito su almeno tre piattaforme" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:Platform ;
                        owl:onProperty vg:availableOn ] ) ] .

vg:MultipleKiller a owl:Class ;
    rdfs:label "MultipleKiller" ;
    rdfs:comment "Un personaggio che ha ucciso almeno due personaggi" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Killer [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:Character ;
                        owl:onProperty vg:kills ] ) ] .

vg:MustPlayGame a owl:Class ;
    rdfs:label "MustPlayGame" ;
    rdfs:comment "Un gioco con almeno 95 su Metacritic" ;
    rdfs:subClassOf vg:VideoGame .

vg:PlayerCharacter a owl:Class ;
    rdfs:label "PlayerCharacter" ;
    rdfs:comment "Un personaggio controllato dal giocatore in almeno un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:playableIn ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:PrequelReturn a owl:Class ;
    rdfs:label "PrequelReturn" ;
    rdfs:comment "Un gioco in cui ricompare un personaggio già morto, spiegato dal fatto che è un prequel" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:ReturnAfterDeathGame vg:PrequelGame ) ] .

vg:Protagonist a owl:Class ;
    rdfs:label "Protagonist" ;
    rdfs:comment "Il protagonista di un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:protagonistOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:Publisher a owl:Class ;
    rdfs:label "Publisher" ;
    rdfs:comment "Un'azienda che ha pubblicato almeno un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Company [ a owl:Restriction ;
                        owl:onProperty vg:publisherOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:RealisticViolenceGame a owl:Class ;
    rdfs:label "RealisticViolenceGame" ;
    rdfs:comment "Un gioco violento classificato PEGI 16 o 18: violenza realistica, non per minori" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:ViolentStoryGame [ a owl:Restriction ;
                        owl:onProperty vg:pegiRating ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 16 ] ) ] ] ) ] .

vg:RecurringVillain a owl:Class ;
    rdfs:label "RecurringVillain" ;
    rdfs:comment "Un antagonista ricorrente" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:RecurringCharacter vg:Antagonist ) ] .

vg:RemasterCollection a owl:Class ;
    rdfs:label "RemasterCollection" ;
    rdfs:comment "Una raccolta che rimasterizza almeno due giochi" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Remaster [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:VideoGame ;
                        owl:onProperty vg:remasterOf ] ) ] .

vg:RemasteredClassic a owl:Class ;
    rdfs:label "RemasteredClassic" ;
    rdfs:comment "Un gioco che ha avuto una nuova edizione" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasRemaster ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:ReturningCharacter a owl:Class ;
    rdfs:label "ReturningCharacter" ;
    rdfs:comment "Un personaggio che ricompare in un gioco uscito dopo quello in cui è stato ucciso" ;
    rdfs:subClassOf vg:DeceasedCharacter .

vg:ReturningDirectorSequel a owl:Class ;
    rdfs:label "ReturningDirectorSequel" ;
    rdfs:comment "Un seguito con lo stesso regista del predecessore" ;
    rdfs:subClassOf vg:VideoGame .

vg:RogueAI a owl:Class ;
    rdfs:label "RogueAI" ;
    rdfs:comment "Un'intelligenza artificiale o un robot antagonista" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Synthetic vg:Antagonist ) ] .

vg:StillPlayable a owl:Class ;
    rdfs:label "StillPlayable" ;
    rdfs:comment "Un gioco giocabile su una console attuale" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:playableOn ;
                        owl:someValuesFrom vg:CurrentGenerationConsole ] ) ] .

vg:TransmediaFranchise a owl:Class ;
    rdfs:label "TransmediaFranchise" ;
    rdfs:comment "Una serie diventata film o serie TV" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Franchise [ a owl:Restriction ;
                        owl:onProperty vg:adaptedInto ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( vg:Film vg:TVSeries ) ] ] ) ] .

vg:VeteransReturn a owl:Class ;
    rdfs:label "VeteransReturn" ;
    rdfs:comment "Un gioco fatto da uno studio fondato da chi aveva lavorato alla serie" ;
    rdfs:subClassOf vg:VideoGame .

vg:hasCharacter a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:appearsIn .

vg:hasGameMode a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:GameMode .

vg:hasGenre a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Genre .

vg:platformFor a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:availableOn .

vg:releaseDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:dateTime .

vg:releasedAfter a owl:ObjectProperty ;
    rdfs:comment "Derivata dalle regole: uscito dopo, nella stessa serie" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .

vg:subsidiaryOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain vg:Company ;
    rdfs:range vg:Company .

vg:techLinkedTo a owl:ObjectProperty ;
    rdfs:comment "Giochi dello studio che ha fatto il motore usato" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame ;
    owl:propertyChainAxiom ( vg:madeWith vg:engineDevelopedBy vg:developerOf ) .

vg:Adaptation a owl:Class ;
    rdfs:label "Adaptation" ;
    rdfs:comment "Un gioco tratto da un'opera di un altro medium" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:basedOn ;
                        owl:someValuesFrom vg:CreativeWork ] ) ] .

vg:Alien a owl:Class ;
    rdfs:label "Alien" ;
    rdfs:comment "Un personaggio di una specie non umana del mondo di gioco" ;
    rdfs:subClassOf vg:Character .

vg:Comic a owl:Class ;
    rdfs:label "Comic" ;
    rdfs:comment "Un fumetto" ;
    rdfs:subClassOf vg:CreativeWork .

vg:CurrentGenerationConsole a owl:Class ;
    rdfs:label "CurrentGenerationConsole" ;
    rdfs:comment "Una console della nona generazione, l'attuale" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:ConsolePlatform [ a owl:Restriction ;
                        owl:onProperty vg:generation ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 9 ] ) ] ] ) ] .

vg:Developer a owl:Class ;
    rdfs:label "Developer" ;
    rdfs:comment "Un'azienda che ha sviluppato almeno un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Company [ a owl:Restriction ;
                        owl:onProperty vg:developerOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:FictionalOrganization a owl:Class ;
    rdfs:label "FictionalOrganization" ;
    rdfs:comment "Un'organizzazione del mondo di gioco (per esempio Aperture Science)" .

vg:HighlyRatedGame a owl:Class ;
    rdfs:label "HighlyRatedGame" ;
    rdfs:comment "Un gioco con almeno 90 su Metacritic" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:metacriticScore ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 90 ] ) ] ] ) ] .

vg:Human a owl:Class ;
    rdfs:label "Human" ;
    rdfs:comment "Un personaggio umano" ;
    rdfs:subClassOf vg:Character .

vg:Killer a owl:Class ;
    rdfs:label "Killer" ;
    rdfs:comment "Un personaggio che ha tolto la vita a qualcuno" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:killerIn ;
                        owl:someValuesFrom vg:Killing ] ) ] .

vg:LateEntry a owl:Class ;
    rdfs:label "LateEntry" ;
    rdfs:comment "Almeno il terzo capitolo di una serie" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:SequelGame [ a owl:Restriction ;
                        owl:onProperty vg:sequelOf ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty vg:sequelOf ;
                                owl:someValuesFrom vg:VideoGame ] ] ) ] .

vg:PCPlatform a owl:Class ;
    rdfs:label "PCPlatform" ;
    rdfs:comment "Un personal computer" ;
    rdfs:subClassOf vg:Platform .

vg:PlatformHolder a owl:Class ;
    rdfs:label "PlatformHolder" ;
    rdfs:comment "Un'azienda che costruisce console" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Company [ a owl:Restriction ;
                        owl:onProperty vg:manufacturerOf ;
                        owl:someValuesFrom vg:ConsolePlatform ] ) ] .

vg:PrequelGame a owl:Class ;
    rdfs:label "PrequelGame" ;
    rdfs:comment "Un gioco la cui storia precede quella di un altro" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:prequelOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:RecurringCharacter a owl:Class ;
    rdfs:label "RecurringCharacter" ;
    rdfs:comment "Un personaggio presente in almeno due giochi" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                        owl:onClass vg:VideoGame ;
                        owl:onProperty vg:appearsIn ] ) ] .

vg:Remaster a owl:Class ;
    rdfs:label "Remaster" ;
    rdfs:comment "La nuova edizione di un altro gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:remasterOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:ReturnAfterDeathGame a owl:Class ;
    rdfs:label "ReturnAfterDeathGame" ;
    rdfs:comment "Un gioco uscito dopo la morte di un suo personaggio: prequel, linea temporale alternativa o resurrezione" ;
    rdfs:subClassOf vg:VideoGame .

vg:SequelByDifferentStudio a owl:Class ;
    rdfs:label "SequelByDifferentStudio" ;
    rdfs:comment "Un seguito sviluppato da uno studio diverso" ;
    rdfs:subClassOf vg:VideoGame .

vg:StudioHead a owl:Class ;
    rdfs:label "StudioHead" ;
    rdfs:comment "Chi guida un'azienda" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Person [ a owl:Restriction ;
                        owl:onProperty vg:heads ;
                        owl:someValuesFrom vg:Company ] ) ] .

vg:TabletopGame a owl:Class ;
    rdfs:label "TabletopGame" ;
    rdfs:comment "Un gioco da tavolo o di ruolo cartaceo" ;
    rdfs:subClassOf vg:CreativeWork .

vg:adaptedInto a owl:ObjectProperty ;
    rdfs:domain vg:Franchise ;
    rdfs:range vg:CreativeWork .

vg:antagonistOf a owl:ObjectProperty ;
    rdfs:domain vg:Character ;
    rdfs:range vg:VideoGame ;
    rdfs:subPropertyOf vg:appearsIn .

vg:belongsTo a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Franchise .

vg:builtBy a owl:ObjectProperty ;
    rdfs:comment "Chi ha costruito il personaggio nel mondo di gioco (un altro personaggio o un'organizzazione)" ;
    rdfs:domain vg:Character ;
    rdfs:range owl:Thing .

vg:developedBy a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .

vg:directorOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:directedBy .

vg:engineDevelopedBy a owl:ObjectProperty ;
    rdfs:domain vg:GameEngine ;
    rdfs:range vg:Company .

vg:formerEmployeeOf a owl:ObjectProperty ;
    rdfs:domain vg:Person ;
    rdfs:range vg:Company .

vg:foundedBy a owl:ObjectProperty ;
    rdfs:domain vg:Company ;
    rdfs:range vg:Person .

vg:generation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain vg:ConsolePlatform ;
    rdfs:range xsd:integer .

vg:hasKilling a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:inGame .

vg:hasWikidataId a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

vg:heads a owl:ObjectProperty ;
    rdfs:domain vg:Person ;
    rdfs:range vg:Company .

vg:inGame a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:Killing ;
    rdfs:range vg:VideoGame .

vg:killedBy a owl:ObjectProperty ;
    rdfs:comment "Dedotta dalla regola KillingEvent" ;
    rdfs:domain vg:Character ;
    rdfs:range vg:Character .

vg:killer a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:Killing ;
    rdfs:range vg:Character .

vg:killerIn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:killer .

vg:kills a owl:ObjectProperty ;
    owl:inverseOf vg:killedBy .

vg:madeWith a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:GameEngine .

vg:manufacturedBy a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:Platform ;
    rdfs:range vg:Company .

vg:manufacturerOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:manufacturedBy .

vg:metacriticScore a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:integer .

vg:playableIn a owl:ObjectProperty ;
    rdfs:comment "Il personaggio è controllato dal giocatore in quel gioco" ;
    rdfs:domain vg:Character ;
    rdfs:range vg:VideoGame ;
    rdfs:subPropertyOf vg:appearsIn .

vg:portrays a owl:ObjectProperty ;
    rdfs:domain vg:Character ;
    rdfs:range vg:Person .

vg:prequelOf a owl:ObjectProperty ;
    rdfs:comment "La storia del gioco si svolge prima di quella dell'altro, anche se è uscito dopo" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .

vg:protagonistOf a owl:ObjectProperty ;
    rdfs:domain vg:Character ;
    rdfs:range vg:VideoGame ;
    rdfs:subPropertyOf vg:appearsIn .

vg:publishedBy a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .

vg:publishedByGroup a owl:ObjectProperty ;
    rdfs:comment "Derivata dalle regole: l'editore e i gruppi che lo controllano" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .

vg:publisherOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:publishedBy .

vg:victim a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:Killing ;
    rdfs:range vg:Character .

vg:Antagonist a owl:Class ;
    rdfs:label "Antagonist" ;
    rdfs:comment "L'antagonista di un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:antagonistOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:Film a owl:Class ;
    rdfs:label "Film" ;
    rdfs:comment "Un film" ;
    rdfs:subClassOf vg:CreativeWork .

vg:GOTYWinner a owl:Class ;
    rdfs:label "GOTYWinner" ;
    rdfs:comment "Un gioco premiato come gioco dell'anno" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:wonAward ;
                        owl:someValuesFrom vg:Award ] ) ] .

vg:GameMode a owl:Class ;
    rdfs:label "GameMode" ;
    rdfs:comment "Una modalità di gioco" .

vg:Genre a owl:Class ;
    rdfs:label "Genre" ;
    rdfs:comment "Un genere" .

vg:Novel a owl:Class ;
    rdfs:label "Novel" ;
    rdfs:comment "Un romanzo" ;
    rdfs:subClassOf vg:CreativeWork .

vg:SequelGame a owl:Class ;
    rdfs:label "SequelGame" ;
    rdfs:comment "Il seguito di un altro gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:sequelOf ;
                        owl:someValuesFrom vg:VideoGame ] ) ] .

vg:Synthetic a owl:Class ;
    rdfs:label "Synthetic" ;
    rdfs:comment "Un personaggio costruito da qualcuno nel mondo di gioco: un'intelligenza artificiale o un robot" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:builtBy ;
                        owl:someValuesFrom owl:Thing ] ) ] .

vg:TVSeries a owl:Class ;
    rdfs:label "TVSeries" ;
    rdfs:comment "Una serie televisiva" ;
    rdfs:subClassOf vg:CreativeWork .

vg:ViolentStoryGame a owl:Class ;
    rdfs:label "ViolentStoryGame" ;
    rdfs:comment "Un gioco nella cui trama qualcuno viene ucciso" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ;
                        owl:onProperty vg:hasKilling ;
                        owl:someValuesFrom vg:Killing ] ) ] .

vg:basedOn a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:CreativeWork .

vg:developerOf a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:developedBy .

vg:directedBy a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Person .

vg:hasRemaster a owl:ObjectProperty ;
    owl:inverseOf vg:remasterOf .

vg:hasSequel a owl:ObjectProperty ;
    owl:inverseOf vg:sequelOf .

vg:pegiRating a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:integer .

vg:playableOn a owl:ObjectProperty ;
    rdfs:comment "Disponibile, anche tramite una nuova edizione" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Platform ;
    owl:propertyChainAxiom ( vg:hasRemaster vg:availableOn ) .

vg:victimIn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:victim .

vg:wonAward a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Award .

vg:DeceasedCharacter a owl:Class ;
    rdfs:label "DeceasedCharacter" ;
    rdfs:comment "Un personaggio ucciso nella trama di un gioco" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( vg:Character [ a owl:Restriction ;
                        owl:onProperty vg:victimIn ;
                        owl:someValuesFrom vg:Killing ] ) ] .

vg:GameEngine a owl:Class ;
    rdfs:label "GameEngine" ;
    rdfs:comment "Un motore di gioco" .

vg:availableOn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Platform ;
    rdfs:subPropertyOf vg:playableOn .

vg:includes a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    owl:inverseOf vg:belongsTo .

vg:remasterOf a owl:ObjectProperty ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .

vg:Award a owl:Class ;
    rdfs:label "Award" ;
    rdfs:comment "Il premio Gioco dell'anno di una cerimonia (The Game Awards, BAFTA, D.I.C.E....)" .

vg:ConsolePlatform a owl:Class ;
    rdfs:label "ConsolePlatform" ;
    rdfs:comment "Una console" ;
    rdfs:subClassOf vg:Platform .

vg:sequelOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Asserita solo verso il predecessore diretto" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .

vg:appearsIn a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:domain vg:Character ;
    rdfs:range vg:VideoGame .

vg:Franchise a owl:Class ;
    rdfs:label "Franchise" ;
    rdfs:comment "Una serie di giochi" .

vg:Platform a owl:Class ;
    rdfs:label "Platform" ;
    rdfs:comment "Una piattaforma su cui si gioca" .

vg:Killing a owl:Class ;
    rdfs:label "Killing" ;
    rdfs:comment "Un'uccisione nella trama di un gioco: vittima, assassino e gioco (relazione n-aria)" .

vg:CreativeWork a owl:Class ;
    rdfs:label "CreativeWork" ;
    rdfs:comment "Un'opera di un altro medium (romanzo, film, serie TV)" .

vg:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "Una persona reale" .

vg:Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:comment "Uno studio, un editore o un gruppo industriale" .

vg:Character a owl:Class ;
    rdfs:label "Character" ;
    rdfs:comment "Un personaggio di finzione" .

vg:VideoGame a owl:Class ;
    rdfs:label "VideoGame" ;
    rdfs:comment "Un videogioco" ;
    owl:hasKey ( vg:hasWikidataId ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vg:VideoGame vg:Company vg:Person vg:Character vg:Platform vg:Franchise vg:GameEngine vg:Award vg:Genre vg:GameMode vg:Killing vg:FictionalOrganization vg:CreativeWork ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vg:ConsolePlatform vg:PCPlatform ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vg:Novel vg:Film vg:TVSeries vg:Comic vg:TabletopGame ) .

[] a owl:AllDisjointClasses ;
    owl:members ( vg:Human vg:Alien vg:Synthetic ) .

