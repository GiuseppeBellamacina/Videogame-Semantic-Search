vg:BandaiNamcoPublishedGame a owl:Class ;
    rdfs:label "Bandai Namco Entertainment Published Game" ;
    rdfs:comment "A video game published by Bandai Namco Entertainment (nominal)" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:publishedBy ; owl:hasValue <http://www.videogame-ontology.org/ontology#pub/Bandai_Namco_Entertainment> ] ) ] .
vg:AmericanGame a owl:Class ;
    rdfs:label "American Game" ;
    rdfs:comment "A video game whose country of origin is United States" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:countryOfOrigin ; owl:hasValue "United States" ] ) ] .
vg:JapaneseGame a owl:Class ;
    rdfs:label "Japanese Game" ;
    rdfs:comment "A video game whose country of origin is Japan" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:countryOfOrigin ; owl:hasValue "Japan" ] ) ] .

# --- Other defined classes
vg:Developer a owl:Class ;
    rdfs:label "Developer" ;
    rdfs:comment "A company that has developed at least one video game. Not disjoint from Publisher: one company can play both roles" ;
    rdfs:subClassOf vg:Company ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:Company [ a owl:Restriction ; owl:onProperty vg:developerOf ; owl:someValuesFrom vg:VideoGame ] ) ] .
vg:Publisher a owl:Class ;
    rdfs:label "Publisher" ;
    rdfs:comment "A company that has published at least one video game. Not disjoint from Developer: one company can play both roles" ;
    rdfs:subClassOf vg:Company ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:Company [ a owl:Restriction ; owl:onProperty vg:publisherOf ; owl:someValuesFrom vg:VideoGame ] ) ] .
vg:AwardWinningGame a owl:Class ;
    rdfs:label "Award Winning Game" ;
    rdfs:comment "A video game that has received at least one award" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:wonAward ; owl:someValuesFrom vg:Award ] ) ] .
vg:GOTYWinner a owl:Class ;
    rdfs:label "Game of the Year Winner" ;
    rdfs:comment "A video game that has won a Game of the Year award" ;
    rdfs:subClassOf vg:AwardWinningGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:wonAward ; owl:someValuesFrom vg:GameOfTheYearAward ] ) ] .
vg:FranchiseGame a owl:Class ;
    rdfs:label "Franchise Game" ;
    rdfs:comment "A video game that is part of a franchise or series" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:belongsTo ; owl:someValuesFrom vg:Franchise ] ) ] .
vg:UnrealEngineGame a owl:Class ;
    rdfs:label "Unreal Engine Game" ;
    rdfs:comment "A video game made with Unreal Engine" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:madeWith ; owl:someValuesFrom vg:UnrealEngineFamily ] ) ] .
vg:HighlyRatedGame a owl:Class ;
    rdfs:label "Highly Rated Game" ;
    rdfs:comment "A video game with a Metacritic score of 85 or above" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:metacriticScore ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:integer ; owl:withRestrictions ( [ xsd:minInclusive 85 ] ) ] ] ) ] .
vg:RecentGame a owl:Class ;
    rdfs:label "Recent Game" ;
    rdfs:comment "A video game released on or after 2020-01-01" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:releaseDate ; owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:dateTime ; owl:withRestrictions ( [ xsd:minInclusive "2020-01-01T00:00:00"^^xsd:dateTime ] ) ] ] ) ] .
vg:MultiConsoleGame a owl:Class ;
    rdfs:label "Multi-Console Game" ;
    rdfs:comment "A video game available on at least two console platforms" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:availableOn ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass vg:ConsolePlatform ] ) ] .
vg:MultiPlatformGame a owl:Class ;
    rdfs:label "Multi-Platform Game" ;
    rdfs:comment "A video game available on at least three platforms" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:availableOn ; owl:minQualifiedCardinality "3"^^xsd:nonNegativeInteger ; owl:onClass vg:Platform ] ) ] .
vg:SequelGame a owl:Class ;
    rdfs:label "Sequel Game" ;
    rdfs:comment "A video game that is a sequel to another game" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:sequelOf ; owl:someValuesFrom vg:VideoGame ] ) ] .
vg:LateEntry a owl:Class ;
    rdfs:label "Late Entry" ;
    rdfs:comment "At least the third chapter of a series: the sequel of a game that is itself a sequel" ;
    rdfs:subClassOf vg:SequelGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:sequelOf ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty vg:sequelOf ; owl:someValuesFrom vg:VideoGame ] ] ) ] .
vg:LongRunningOriginal a owl:Class ;
    rdfs:label "Long-Running Original" ;
    rdfs:comment "A game whose sequel has a sequel in turn: the first chapters of long series" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:hasSequel ; owl:someValuesFrom [ a owl:Restriction ; owl:onProperty vg:hasSequel ; owl:someValuesFrom vg:VideoGame ] ] ) ] .
vg:AcclaimedSequel a owl:Class ;
    rdfs:label "Acclaimed Sequel" ;
    rdfs:comment "A sequel that is also highly rated (class defined on other defined classes)" ;
    rdfs:subClassOf vg:SequelGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:SequelGame vg:HighlyRatedGame ) ] .
vg:PlatformHolder a owl:Class ;
    rdfs:label "Platform Holder" ;
    rdfs:comment "A company that makes at least one console" ;
    rdfs:subClassOf vg:Company ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:Company [ a owl:Restriction ; owl:onProperty vg:manufacturerOf ; owl:someValuesFrom vg:ConsolePlatform ] ) ] .
vg:FirstPartyGame a owl:Class ;
    rdfs:label "First-Party Game" ;
    rdfs:comment "A game published by a platform holder or by a company of its group" ;
    rdfs:subClassOf vg:VideoGame ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:VideoGame [ a owl:Restriction ; owl:onProperty vg:publishedByGroup ; owl:someValuesFrom vg:PlatformHolder ] ) ] .
vg:LongRunningFranchise a owl:Class ;
    rdfs:label "Long-Running Franchise" ;
    rdfs:comment "A series with at least three chapters: it includes a late entry" ;
    rdfs:subClassOf vg:Franchise ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:Franchise [ a owl:Restriction ; owl:onProperty vg:includes ; owl:someValuesFrom vg:LateEntry ] ) ] .
vg:FranchiseWithStudioChange a owl:Class ;
    rdfs:label "Franchise with Studio Change" ;
    rdfs:comment "A series in which a sequel was developed by a different studio (built on a SWRL conclusion)" ;
    rdfs:subClassOf vg:Franchise ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vg:Franchise [ a owl:Restriction ; owl:onProperty vg:includes ; owl:someValuesFrom vg:SequelByDifferentStudio ] ) ] .

# --- Target classes of the SWRL rules (swrl_rules.ttl)
vg:SelfPublishedGame a owl:Class ;
    rdfs:label "Self-Published Game" ;
    rdfs:comment "A game developed and published by the same company (SWRL rule)" ;
    rdfs:subClassOf vg:VideoGame .
vg:SequelByDifferentStudio a owl:Class ;
    rdfs:label "Sequel by Different Studio" ;
    rdfs:comment "A sequel developed by a studio different from the one of its predecessor (SWRL rule)" ;
    rdfs:subClassOf vg:VideoGame .
vg:FirstPartyOnRivalConsole a owl:Class ;
    rdfs:label "First-Party Game on a Rival Console" ;
    rdfs:comment "A first-party game that also came out on a console made by another platform holder (SWRL rule)" ;
    rdfs:subClassOf vg:VideoGame .
vg:CouchCoopCandidate a owl:Class ;
    rdfs:label "Couch Co-op Candidate" ;
    rdfs:comment "A game with a co-op mode available on a console (SWRL rule)" ;
    rdfs:subClassOf vg:VideoGame .
vg:MustPlayGame a owl:Class ;
    rdfs:label "Must-Play Game" ;
    rdfs:comment "A game with a Metacritic score above 94 (SWRL rule)" ;
    rdfs:subClassOf vg:VideoGame .

# --- Object properties
vg:developedBy a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "developed by" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .
vg:developerOf a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "developer of" ;
    rdfs:domain vg:Company ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:developedBy .
vg:publishedBy a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "published by" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .
vg:publisherOf a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "publisher of" ;
    rdfs:domain vg:Company ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:publishedBy .
vg:hasGenre a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "has genre" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Genre .
vg:genreOf a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "genre of" ;
    rdfs:domain vg:Genre ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:hasGenre .
vg:availableOn a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "available on" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Platform .
vg:platformFor a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "platform for" ;
    rdfs:domain vg:Platform ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:availableOn .
vg:hasGameMode a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "has game mode" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:GameMode .
vg:modeInGame a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "mode in game" ;
    rdfs:domain vg:GameMode ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:hasGameMode .
vg:hasCharacter a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "has character" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Character .
vg:appearsIn a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "appears in" ;
    rdfs:domain vg:Character ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:hasCharacter .
vg:belongsTo a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "belongs to" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Franchise .
vg:includes a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "includes" ;
    rdfs:domain vg:Franchise ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:belongsTo .
vg:wonAward a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "won award" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Award .
vg:awardWonBy a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "award won by" ;
    rdfs:domain vg:Award ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:wonAward .
vg:madeWith a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "made with" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:GameEngine .
vg:engineUsedIn a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "engine used in" ;
    rdfs:domain vg:GameEngine ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:madeWith .
vg:manufacturedBy a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "manufactured by" ;
    rdfs:comment "The company that makes the platform (Wikidata P176)" ;
    rdfs:domain vg:Platform ;
    rdfs:range vg:Company .
vg:manufacturerOf a owl:ObjectProperty, owl:IrreflexiveProperty, owl:AsymmetricProperty ;
    rdfs:label "manufacturer of" ;
    rdfs:domain vg:Company ;
    rdfs:range vg:Platform ;
    owl:inverseOf vg:manufacturedBy .
vg:sequelOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "sequel of" ;
    rdfs:comment "A later game of the same series. Asserted towards the direct predecessor only; the rest of the series follows by transitivity" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .
vg:hasSequel a owl:ObjectProperty ;
    rdfs:label "has sequel" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame ;
    owl:inverseOf vg:sequelOf .
vg:subsidiaryOf a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "subsidiary of" ;
    rdfs:comment "A company controlled by another (Wikidata P749); transitive, so a studio belongs to every group above it" ;
    rdfs:domain vg:Company ;
    rdfs:range vg:Company .
vg:publishedByGroup a owl:ObjectProperty ;
    rdfs:label "published by group" ;
    rdfs:comment "The publisher or any group that controls it" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:Company .
vg:sharesDeveloperWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "shares developer with" ;
    rdfs:comment "Two games developed by the same studio (property chain)" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .
vg:sharesPublisherWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "shares publisher with" ;
    rdfs:comment "Two games published by the same company (property chain)" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .
vg:sharedFranchiseWith a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "shared franchise with" ;
    rdfs:comment "Two games of the same franchise (property chain)" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range vg:VideoGame .
vg:sharesDeveloperWith owl:propertyChainAxiom ( vg:developedBy vg:developerOf ) .
vg:sharesPublisherWith owl:propertyChainAxiom ( vg:publishedBy vg:publisherOf ) .
vg:sharedFranchiseWith owl:propertyChainAxiom ( vg:belongsTo vg:includes ) .
vg:publishedByGroup owl:propertyChainAxiom ( vg:publishedBy vg:subsidiaryOf ) .
vg:publishedBy rdfs:subPropertyOf vg:publishedByGroup .

# --- Datatype properties (the functional ones are DL-only axioms, kept for HermiT)
vg:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .
vg:gameName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "game name" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name ;
    skos:closeMatch dcterms:title .
vg:developerName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "developer name" ;
    rdfs:domain vg:Developer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:publisherName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "publisher name" ;
    rdfs:domain vg:Publisher ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:genreName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "genre name" ;
    rdfs:domain vg:Genre ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:platformName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "platform name" ;
    rdfs:domain vg:Platform ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:characterName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "character name" ;
    rdfs:domain vg:Character ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:franchiseName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "franchise name" ;
    rdfs:domain vg:Franchise ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:awardName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "award name" ;
    rdfs:domain vg:Award ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:engineName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "engine name" ;
    rdfs:domain vg:GameEngine ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf vg:name .
vg:releaseDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "release date" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:dateTime ;
    skos:closeMatch dcterms:issued .
vg:metacriticScore a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "Metacritic score" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:integer .
vg:countryOfOrigin a owl:DatatypeProperty ;
    rdfs:label "country of origin" ;
    rdfs:domain vg:VideoGame ;
    rdfs:range xsd:string .
vg:hasWikidataId a owl:DatatypeProperty ;
    rdfs:label "Wikidata ID" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

# --- Keys and alignments (skos:closeMatch, not equivalence)
vg:VideoGame owl:hasKey ( vg:hasWikidataId ) .
vg:VideoGame skos:closeMatch wd:Q7889 .
vg:Developer skos:closeMatch wd:Q210167 .
vg:Genre skos:closeMatch wd:Q65956376 .
vg:GameEngine skos:closeMatch wd:Q193564 .
