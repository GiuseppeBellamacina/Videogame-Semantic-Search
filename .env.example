# LLM: "<provider>:<model>" — openai:gpt-4.1-mini, anthropic:haiku5.5, ...
LLM_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Comma-separated list of allowed CORS origins (local dev: http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173

HOST=0.0.0.0
PORT=8000

# Frontend: leave empty in local dev (the Vite proxy forwards /api to localhost:8000)
VITE_API_URL=
